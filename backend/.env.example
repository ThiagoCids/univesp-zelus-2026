# ==============================================================
# Arquivo: .env.example  —  Backend ZELUS
# ==============================================================
# Este arquivo serve como MODELO para as variáveis de ambiente.
# Copie este arquivo, renomeie para ".env" e preencha com seus
# dados reais. NUNCA suba o arquivo .env para o repositório Git!
# ==============================================================

# -- Porta em que o servidor Express vai rodar localmente --
PORT=3001

# -- URL do projeto no Supabase --
# Encontre em: Supabase Dashboard > Settings > API > Project URL
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# -- Chave secreta do Supabase (service_role key) --
# ATENÇÃO: Esta chave tem acesso total ao banco. Nunca exponha no frontend!
# Encontre em: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_KEY=sua_chave_secreta_aqui

# -- Chave pública do Supabase (anon key) --
# Esta chave é usada para operações públicas (com regras de segurança ativas).
SUPABASE_ANON_KEY=sua_chave_anonima_aqui
