# ==============================================================
# Arquivo: .env.example  —  Frontend ZELUS
# ==============================================================
# Este arquivo serve como MODELO para as variáveis de ambiente.
# Copie este arquivo, renomeie para ".env" e preencha com seus
# dados reais. NUNCA suba o arquivo .env para o repositório Git!
#
# No React (Create React App), toda variável de ambiente precisa
# começar com REACT_APP_ para ser acessível no código do frontend.
# ==============================================================

# -- URL do projeto no Supabase (pública) --
REACT_APP_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# -- Chave anônima do Supabase (pública) --
# Esta chave pode aparecer no frontend — ela é protegida pelas
# regras de segurança (RLS) configuradas no Supabase.
REACT_APP_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# -- URL base da API do backend ZELUS --
REACT_APP_API_URL=http://localhost:3001
