# ==============================================================
# Arquivo: .gitignore  —  Frontend ZELUS
# ==============================================================
# Lista de arquivos e pastas que o Git deve IGNORAR (não versionar).
# ==============================================================

# -- Dependências do Node.js --
node_modules/

# -- Arquivo de variáveis de ambiente reais --
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# -- Pasta de build gerada pelo "npm run build" --
# Esta pasta contém os arquivos finais para produção. É gerada
# automaticamente e não precisa ser versionada.
build/

# -- Logs --
*.log
npm-debug.log*
